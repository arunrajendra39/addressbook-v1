pipeline {
    agent any
    tools{
        jdk 'myjava'
        maven 'mymaven'
    }

    stages {
        stage('Compile') {
            steps {
                echo 'Compile the code'
                sh 'mvn compile'
            }
        }
        stage('CodeReview') {
            steps {
                echo 'Review the code'
                sh 'mvn pmd:pmd'
            }
        }
        stage('UnitTest') {
            steps {
                echo 'Test the code'
                sh 'mvn test'
            }
        }
        stage('CoverageAnalysis') {
            steps {
                echo 'Coverage the code'
                sh 'mvn verify'
            }
        }
        stage('Package') {
            steps {
                echo 'Package the code'
                sh 'mvn package'
            }
        }
    }
}
